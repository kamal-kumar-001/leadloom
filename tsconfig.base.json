{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@leadloom/contracts": ["./packages/contracts/dist/index.d.ts", "./packages/contracts/src/index.ts"],
      "@leadloom/contracts/*": ["./packages/contracts/dist/*", "./packages/contracts/src/*"]
    }
  }
}
