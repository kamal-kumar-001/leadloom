async function fingerprint(db:PrismaClient){
 const tables:any[]=await db.$queryRawUnsafe("SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename");const result:any[]=[];
 for(const {tablename}of tables){assert(/^[A-Za-z_][A-Za-z_0-9]*$/.test(tablename));const rows:any[]=await db.$queryRawUnsafe('SELECT to_jsonb(t)::text AS document FROM public."'+tablename+'" t ORDER BY to_jsonb(t)::text');const hash=createHash('sha256');for(const r of rows)hash.update(r.document+'\n');result.push({table:tablename,rows:rows.length,sha256:hash.digest('hex')});}return result;
}
async function schema(db:PrismaClient){return db.$queryRawUnsafe(`SELECT t.relname AS table_name,a.attname AS column_name,format_type(a.atttypid,a.atttypmod) AS type,a.attnotnull AS required,pg_get_expr(d.adbin,d.adrelid) AS default_value FROM pg_class t JOIN pg_namespace n ON n.oid=t.relnamespace JOIN pg_attribute a ON a.attrelid=t.oid AND a.attnum>0 AND NOT a.attisdropped LEFT JOIN pg_attrdef d ON d.adrelid=t.oid AND d.adnum=a.attnum WHERE n.nspname='public' AND t.relkind='r' ORDER BY t.relname,a.attnum`);}
async function indexes(db:PrismaClient){return db.$queryRawUnsafe(`SELECT t.relname AS table_name,i.relname AS index_name,m.amname AS method,x.indisunique AS unique_index,x.indisprimary AS primary_index,x.indisvalid AS valid_index,x.indkey::text AS column_positions,x.indnkeyatts AS key_columns,x.indnatts AS all_columns FROM pg_index x JOIN pg_class t ON t.oid=x.indrelid JOIN pg_class i ON i.oid=x.indexrelid JOIN pg_namespace n ON n.oid=t.relnamespace JOIN pg_am m ON m.oid=i.relam WHERE n.nspname='public' ORDER BY t.relname,i.relname`);}
async function constraints(db:PrismaClient){const rows:any[]=await db.$queryRawUnsafe(`SELECT t.relname AS table_name,c.conname,c.contype,pg_get_constraintdef(c.oid) AS definition FROM pg_constraint c JOIN pg_class t ON t.oid=c.conrelid JOIN pg_namespace n ON n.oid=t.relnamespace WHERE n.nspname='public' ORDER BY t.relname,c.conname`);for(const row of rows){if(row.contype!=='c')continue;assert(/^[A-Za-z_][A-Za-z_0-9]*$/.test(row.table_name));row.definition=await db.$transaction(async tx=>{await tx.$executeRawUnsafe('CREATE TEMP TABLE _leadloom_recovery_normalize (LIKE public."'+row.table_name+'") ON COMMIT DROP');await tx.$executeRawUnsafe('ALTER TABLE _leadloom_recovery_normalize ADD CONSTRAINT normalized '+row.definition);const result:any[]=await tx.$queryRawUnsafe("SELECT pg_get_constraintdef(oid) AS definition FROM pg_constraint WHERE conrelid='pg_temp._leadloom_recovery_normalize'::regclass AND conname='normalized'");return result[0].definition;});}return rows;}
