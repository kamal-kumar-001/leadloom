{
  "name": "leadloom",
  "version": "0.1.0",
  "private": true,
  "description": "LeadLoom — The Open-Core Signal-to-Revenue Engine",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "build": "turbo run build || npm run --workspaces --if-present build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test || vitest run"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
