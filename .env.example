# ==============================================================================
# LeadLoom — Single-VPS Container Environment Configuration Template
# ==============================================================================

POSTGRES_USER=leadloom
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=leadloom_db
DATABASE_URL=postgresql://leadloom:your_secure_password_here@postgres:5432/leadloom_db?schema=public

REDIS_HOST=redis
REDIS_PORT=6379

LEADLOOM_MASTER_KEY=your_32_byte_hex_key_here
LEADLOOM_MASTER_KEY_VERSION=1
LEADLOOM_SESSION_KEY=your_32_byte_base64_session_key_here

ENGINE_PORT=4010
WEB_PORT=3000

APP_BASE_URL=https://leadloom.dmpilot.org
NEXT_PUBLIC_API_URL=https://leadloom.dmpilot.org/api
