 const first=await(await fetch(api+'/validator/experiments/'+experiment.experimentId+'/scorecard',{headers})).json();const page=(await db.query('SELECT id,visitors FROM smoke_test_pages WHERE experiment_id=$1',[experiment.experimentId])).rows[0];assert.equal(page.visitors,0);assert.equal(first.metrics.pageConversions,1);
 for(let i=0;i<29;i++)await db.query('INSERT INTO waitlist_leads(id,page_id,email,survey_responses)VALUES($1,$2,$3,$4)',[randomUUID(),page.id,'seed-'+i+'@example.invalid',{}]);
 const outreach=await fetch(api+'/validator/experiments/'+experiment.experimentId+'/outreach',{method:'POST',headers,body:JSON.stringify({outreachSent:20,replies:0,positiveReplies:0})});assert.equal(outreach.status,200);const scored=await outreach.json();const result={scope:'actual compiled native API; private local publication and capture,29 seeded fake leads,20 owner-recorded fixture outreach, no sends or real traffic',nativePageLoads:page.visitors,capturedThroughPublicAPI:1,firstReportedLoads:first.metrics.visitors,nativeLeads:30,reportedLoads:scored.metrics.visitors,reportedRate:scored.metrics.pageConversionRate,verdict:scored.verdict,score:scored.verdictScore};console.log(JSON.stringify(result));assert.equal(result.firstReportedLoads,0);assert.equal(result.reportedLoads,0);assert.equal(result.reportedRate,null);assert.equal(result.verdict,'pending');assert.equal(result.score,0);
 const cookie=await encode({secret,salt:'authjs.session-token',token:{sub:uid,email,idp:'google',email_verified:true,authTime:Math.floor(Date.now()/1000)-60}});browser=await puppeteer.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']});const view=await browser.newPage();await view.setViewport({width:1440,height:1100});let outside=0;await view.setRequestInterception(true);view.on('request',(request:any)=>{if(!request.url().startsWith(base)&&!request.url().startsWith('data:')&&!request.url().startsWith('blob:')){outside++;void request.abort();return;}void request.continue();});await view.setCookie({name:'authjs.session-token',value:cookie,url:base});await view.goto(base+'/app/validator',{waitUntil:'networkidle0'});await view.waitForFunction(()=>Array.from(document.querySelectorAll('button')).some(b=>b.textContent?.includes('Private native scorecard counter fixture')));await view.evaluate(()=>{(Array.from(document.querySelectorAll('button')).find(b=>b.textContent?.includes('Private native scorecard counter fixture'))as HTMLButtonElement).click();});await view.waitForSelector('[data-testid=experiment-scorecard]');const panel=await view.$('[data-testid=experiment-scorecard]');assert(panel);const text=await panel.evaluate(e=>e.textContent??'');assert(text.includes('Signup-to-load rate unavailable'));assert(text.includes('Pending'));assert(!text.includes('high_pull'));await panel.screenshot({path:'/downloads/leadloom-v85-observed-scorecard.png'});assert.equal(outside,0);assert.equal((await db.query('SELECT visitors FROM smoke_test_pages WHERE id=$1',[page.id])).rows[0].visitors,0);
 const oneLoad=await fetch(api+'/validator/pages/'+owner.slug);assert.equal(oneLoad.status,200);const afterOne=await(await fetch(api+'/validator/experiments/'+experiment.experimentId+'/scorecard',{headers})).json();assert.equal(afterOne.metrics.visitors,1);assert.equal(afterOne.metrics.pageConversionRate,null);assert.equal(afterOne.verdict,'pending');
