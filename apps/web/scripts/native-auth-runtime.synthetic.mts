 await page.goto(base+'/login',{waitUntil:'domcontentloaded'});await page.waitForSelector('#password');await page.type('#email',email);await page.type('#password',password);await page.click('button[type=submit]');await page.waitForFunction(()=>location.pathname==='/verify-email'||document.body.innerText.includes('Email or password is incorrect'));console.log('UNVERIFIED_BROWSER_RECOVERY',new URL(page.url()).pathname);assert.equal(new URL(page.url()).pathname,'/verify-email','Correct unverified credentials should open verification rather than generic bad-password message');await page.waitForSelector('#otp-code');await page.screenshot({path:'/downloads/leadloom-native-unverified-login-recovery.png',fullPage:false});
