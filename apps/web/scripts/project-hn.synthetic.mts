try{
 await db.connect();await db.query('INSERT INTO workspaces(id,name,updated_at)VALUES($1,$2,now())',[ws,'Native HN research fixture']);await db.query("INSERT INTO users(id,workspace_id,email,name,role,email_verified_at,updated_at)VALUES($1,$2,$3,'HN fixture operator','admin',now(),now())",[uid,ws,email]);for(const [id,slug] of [[pid,'hn-alpha'],[other,'hn-beta']])await db.query('INSERT INTO projects(id,workspace_id,slug,name)VALUES($1,$2,$3,$3)',[id,ws,slug]);
 fixture=createServer((req:any,res:any)=>{requests++;const u=new URL(req.url,'http://localhost');assert.equal(u.pathname,'/api/v1/search');assert.equal(u.searchParams.get('hitsPerPage'),'10');assert.equal(u.searchParams.get('tags'),'comment');assert.equal(req.headers.authorization,undefined);res.setHeader('Content-Type','application/json');res.end(JSON.stringify({hits:[{objectID:'123',story_title:'Fixture public evidence',comment_text:'<p>A fixture problem &amp; need.</p>',author:'fixture',created_at:'2026-11-01T00:00:00Z'}]}));});await new Promise<void>(r=>fixture.listen(0,'127.0.0.1',r));
 const local='http://127.0.0.1:'+fixture.address().port;writeFileSync(dir+'/fetch-fixture.mjs',`const real=globalThis.fetch;globalThis.fetch=(url,options)=>{const text=String(url);if(text.startsWith('https://hn.algolia.com/api/v1/search?')){const u=new URL(text);return real(${JSON.stringify(local)}+u.pathname+u.search,options);}return real(url,options);};`);
 await start(false);web=spawn(process.execPath,[root+'apps/web/.next/standalone/apps/web/server.js'],{cwd:root+'apps/web',env:{...common,PORT:'3199',HOSTNAME:'127.0.0.1',ENGINE_URL:api,AUTH_SECRET:secret,NEXTAUTH_SECRET:secret,AUTH_URL:base,NEXTAUTH_URL:'',NEXT_PUBLIC_APP_URL:'',LEADLOOM_PUBLIC_API_URL:'',AUTH_TRUST_HOST:'true'},stdio:['ignore','pipe','pipe']});web.stderr.on('data',(d:Buffer)=>logs.push(d.toString()));await ready(base+'/api/health',web);
 const scoped=await issue(['project:research:search']),context=await issue(['context:read']),wildcard=await issue(['*']);assert.equal((await post(scoped.token)).status,503);assert.equal(requests,0);assert.equal(Number((await db.query("SELECT count(*) FROM public_rate_limit_buckets WHERE key LIKE $1",['agent-hn:workspace:'+ws])).rows[0].count),0);
 await stop(engine);await start(true);
 assert.equal((await post(context.token)).status,403);assert.equal((await post(wildcard.token)).status,403);assert.equal((await post(scoped.token,{query:'public fixture',projectId:other})).status,400);assert.equal((await post(scoped.token,{query:'public fixture'},'?projectId='+other)).status,400);assert.equal(requests,0);
 const cookie=await encode({secret,salt:'authjs.session-token',token:{sub:uid,email,idp:'google',email_verified:true,authTime:Math.floor(Date.now()/1000)-60}});
 const bundle=await fetch(base+'/api/projects/'+pid+'/bundle',{headers:{Cookie:'authjs.session-token='+cookie}});assert.equal(bundle.status,200,await bundle.clone().text());const tar=gunzipSync(Buffer.from(await bundle.arrayBuffer()));let found=false;for(let pos=0;pos+512<=tar.length;){const header=tar.subarray(pos,pos+512),name=header.subarray(0,100).toString().replace(/\0.*$/s,''),size=parseInt(header.subarray(124,136).toString().replace(/\0.*$/s,'').trim(),8)||0;if(!name)break;if(name==='cli.mjs'){writeFileSync(dir+'/cli.mjs',tar.subarray(pos+512,pos+512+size));found=true;}pos+=512+Math.ceil(size/512)*512;}assert(found,'Actual downloaded bundle contains CLI');
 const good=await cli(scoped.token);assert.equal(good.code,0,good.text);assert.deepEqual(JSON.parse(good.text).items.map((p:any)=>p.text),['A fixture problem & need.']);assert.equal(requests,1);assert.equal(JSON.parse(good.text).persisted,false);assert.equal(JSON.parse(good.text).projectId,pid);
 for(let i=0;i<5;i++)assert.equal((await post(scoped.token)).status,200);const limited=await post(scoped.token);assert.equal(limited.status,429);assert.equal(limited.headers.get('retry-after'),'60');assert.equal(requests,6);
