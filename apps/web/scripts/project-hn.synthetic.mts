 browser=await puppeteer.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']});const page=await browser.newPage();await page.setViewport({width:1440,height:1200});await page.setCookie({name:'authjs.session-token',value:cookie,url:base});await page.goto(base+'/app/projects',{waitUntil:'networkidle0'});await page.waitForFunction(()=>document.body.innerText.includes('Workspace Projects'));
 const click=async(text:string)=>{for(const button of await page.$$('button'))if(await button.evaluate((b:any,t:string)=>b.textContent.trim()===t,text)){await button.click();return;}throw Error('Missing button '+text);};
 await page.evaluate(()=>{const b=Array.from(document.querySelectorAll('button')).find(x=>x.textContent?.trim()==='Issue Token'||x.textContent?.trim()==='Issue Agent Token');if(!b)throw Error('Missing issue control');b.click();});await page.waitForFunction(()=>document.body.innerText.includes('Custom'));await page.evaluate(()=>{const b=Array.from(document.querySelectorAll('button')).find(x=>x.textContent?.includes('Custom / Advanced'));if(!b)throw Error('Missing custom preset');b.click();});await page.waitForFunction(()=>document.body.innerText.includes('project:research:search'));const scope=await page.$('button[aria-pressed]');assert(scope);await page.evaluate(()=>{const b=Array.from(document.querySelectorAll('button')).find(x=>x.textContent?.trim()==='project:research:search');b?.scrollIntoView({block:'center'});});await page.screenshot({path:'/downloads/leadloom-hn-scope-ui.png',fullPage:false});
 console.log(JSON.stringify({scope:'actual compiled web+engine, downloaded generated CLI, native PostgreSQL16 and loopback HN HTTP fixture only',operatorFlagDefaultOff:true,explicitScopeRequired:true,crossProjectOverridesRefused:true,requests,rateLimitSurvivesRestart:true,counts,liveNetworkOrCustomerAccounts:false}));
