import pg from 'pg';
import {mkdtempSync,mkdirSync,cpSync,readFileSync,writeFileSync,readdirSync} from 'node:fs';
import {execFileSync} from 'node:child_process';
import {randomUUID} from 'node:crypto';
import assert from 'node:assert/strict';
const root=new URL('../../../',import.meta.url).pathname,name='leadloom_project_upgrade_'+Date.now(),user=process.env.USER,socket='/tmp/leadloom-pg-race/socket';
const admin=new pg.Client({host:socket,port:56539,database:'postgres',user});await admin.connect();await admin.query('CREATE DATABASE '+name);const url='postgresql://'+user+'@localhost:56539/'+name+'?host='+encodeURIComponent(socket);const tmp=mkdtempSync('/tmp/leadloom-upgrade-');mkdirSync(tmp+'/migrations');cpSync(root+'packages/database/prisma/schema.prisma',tmp+'/schema.prisma');cpSync(root+'packages/database/prisma/migrations/migration_lock.toml',tmp+'/migrations/migration_lock.toml');
for(const dir of readdirSync(root+'packages/database/prisma/migrations').filter(d=>/^\d{8}_/.test(d)&&d<'20261207_experiment_project'))cpSync(root+'packages/database/prisma/migrations/'+dir,tmp+'/migrations/'+dir,{recursive:true});
let db:pg.Client|undefined;
try{
 const env={...process.env,DATABASE_URL:url,SCHEMA:tmp+'/schema.prisma'};const baseline=execFileSync('sh',['scripts/bootstrap-fresh.sh'],{cwd:root+'packages/database',env,encoding:'utf8',timeout:90000});
 db=new pg.Client({connectionString:url});await db.connect();const ws=randomUUID(),project=randomUUID(),experiment=randomUUID(),page=randomUUID();await db.query('INSERT INTO workspaces(id,name,updated_at)VALUES($1,$2,now())',[ws,'Synthetic upgrade preservation']);await db.query("INSERT INTO projects(id,workspace_id,slug,name)VALUES($1,$2,'alpha','Alpha')",[project,ws]);await db.query("INSERT INTO validation_experiments(id,workspace_id,hypothesis,outreach_sent,replies,positive_replies,updated_at)VALUES($1,$2,'Existing experiment stays unassigned',8,3,1,now())",[experiment,ws]);await db.query("INSERT INTO smoke_test_pages(id,experiment_id,slug,title,headline,subheadline,status,visitors,updated_at)VALUES($1,$2,$3,'Existing','Existing','Existing','published',11,now())",[page,experiment,'upgrade-'+randomUUID()]);await db.query("INSERT INTO waitlist_leads(id,page_id,email,survey_responses)VALUES($1,$2,'existing@example.invalid','{\"Question\":\"Answer\"}')",[randomUUID(),page]);
 const before=(await db.query('SELECT row_to_json(e) AS data FROM validation_experiments e WHERE id=$1',[experiment])).rows[0].data;const upgraded=execFileSync('npx',['prisma','migrate','deploy'],{cwd:root+'packages/database',env:{...process.env,DATABASE_URL:url},encoding:'utf8',timeout:90000});const after=(await db.query('SELECT row_to_json(e) AS data FROM validation_experiments e WHERE id=$1',[experiment])).rows[0].data;assert.equal(after.project_id,null);delete after.project_id;assert.deepEqual(after,before);assert.equal((await db.query('SELECT count(*)::int AS n FROM _prisma_migrations WHERE finished_at IS NOT NULL')).rows[0].n,34);assert.equal((await db.query('SELECT visitors,status FROM smoke_test_pages WHERE id=$1',[page])).rows[0].visitors,11);assert.deepEqual((await db.query('SELECT survey_responses FROM waitlist_leads WHERE page_id=$1',[page])).rows[0].survey_responses,{Question:'Answer'});await db.query('DELETE FROM workspaces WHERE id=$1',[ws]);console.log(baseline.slice(-500));console.log(upgraded);console.log('PASS existing 28-migration database upgrades to 31 with experiment/counters/timestamps/page/publication/leads intact, explicit NULL ownership, workspace cascade delete remains valid. Disposable only.');
}finally{await db?.end();await admin.query('DROP DATABASE '+name);await admin.end();}
